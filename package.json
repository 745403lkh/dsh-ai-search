{
  "name": "dsh-ai-search",
  "version": "1.4.4-beta.4",
  "type": "module",
  "description": "AI 搜索模式：答疑 / 百科 / 浏览三模式，联网检索、广告过滤、AI 排序摘要与百科词条，支持结果语言、百科档位、浏览三指标权重、页面状态保留与搜索历史；兼容 dsh-better-sidebar（侧边栏页签多开、引擎栏、自定义搜索引擎）。",
  "license": "MIT",
  "author": "Akivelli",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "search",
    "web-search",
    "ai-search"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/745403lkh/dsh-ai-search.git"
  },
  "homepage": "https://github.com/745403lkh/dsh-ai-search#readme",
  "bugs": {
    "url": "https://github.com/745403lkh/dsh-ai-search/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
